# Optional: when set, Frontend and Backend agents generate source files with Gemini.
GEMINI_API_KEY=
# ===================== SERVER =====================
PORT=4000

# ===================== AI PROVIDER =====================
# If set, agents use a real LLM to plan/generate code instead of the
# built-in deterministic templates. Without this, the system still runs
# end-to-end using rule-based generation so the MVP works with zero keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ===================== GITHUB =====================
# Create a GitHub OAuth App: https://github.com/settings/developers
# Callback URL: http://localhost:4000/api/connections/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ===================== VERCEL =====================
# Personal access token: https://vercel.com/account/tokens
VERCEL_API_TOKEN=

# ===================== RENDER =====================
# API key: https://dashboard.render.com/u/settings#api-keys
RENDER_API_KEY=

# ===================== MONGODB ATLAS =====================
# Programmatic API keys: https://cloud.mongodb.com/v2#/org/.../access/apiKeys
MONGODB_ATLAS_PUBLIC_KEY=
MONGODB_ATLAS_PRIVATE_KEY=
MONGODB_ATLAS_GROUP_ID=

# ===================== FIREBASE =====================
FIREBASE_SERVICE_ACCOUNT_JSON=

# ===================== SECURITY =====================
# Used to encrypt stored connection tokens at rest (see src/integrations/secretStore.js)
CREDENTIAL_ENCRYPTION_KEY=change-me-32-bytes-min-please
